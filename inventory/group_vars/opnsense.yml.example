---
# Laisser à true uniquement pour un certificat autosigné (à éviter en production).
opnsense_validate_certs: true

# Les identifiants API sont definis de maniere chiffree et independante dans :
# host_vars/<nom-du-firewall>/vault.yml

# Ces alias sont crees sur tous les hotes du groupe "opnsense".
# Chaque adresse devient une ligne du champ "Content" de l'alias OPNsense.
opnsense_aliases_global:
  - name: SRV_WEB
    description: "Serveurs web publies"
    content:
      - 10.20.10.11
      - 10.20.10.12
  - name: SRV_DNS
    description: "Resolveurs DNS internes"
    content:
      - 10.20.20.53
      - 2001:db8:20::53
